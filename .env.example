# TradingPal-AI — Environment Variables Template
# Copy this file to .env and fill in your values:  cp .env.example .env

# Gemini API key — required for AI recommendations
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# NewsAPI key — optional (falls back to simulated news if absent)
# Get yours free at: https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# Path to FinSen dataset CSV — optional (falls back to simulated sentiment if absent)
# Download from: https://www.kaggle.com/datasets/miguelaenlle/massive-stock-news-analysis-db-for-nlpbacktests
FINSEN_DATA_PATH=data/finsen_data/US_Financial_News.csv
